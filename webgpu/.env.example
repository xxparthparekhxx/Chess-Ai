# Copy to .env.local (git-ignored) to override. Values are read at build time.

# Where the network is fetched from. Leave empty in development to use /model/chess_net.onnx
# (served from webgpu/model/ by the dev server). Production builds use .env.production.
# VITE_MODEL_URL=https://huggingface.co/xxparthparekhxx/sigma-go/resolve/main/chess_net.onnx

# Change when you publish a new network so returning visitors fetch it again.
# VITE_MODEL_VERSION=1

# Where browsers that have WebGPU but not JSPI load onnxruntime-web's 28 MiB WebGPU runtime from.
# Default is jsDelivr (pinned to the onnxruntime-web version). Set to an empty string to turn that path off.
# VITE_ORT_EXTERNAL_BASE=
