{
  "name": "sigma-go-web",
  "private": true,
  "version": "0.1.0",
  "description": "Browser version of the Sigma-Go chess engine (WebGPU with a WebAssembly fallback)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && vite build --mode localmodel",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run test/encoding.test.ts test/search.test.ts",
    "export:model": "../.venv/bin/python ../scripts/export_onnx.py",
    "fixtures": "../.venv/bin/python ../scripts/make_fixtures.py"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "chess.js": "1.4.0",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "onnxruntime-node": "1.31.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
